@using Prototype01.Models
@page "/"

@using Azure.Storage.Blobs
@using System.Text.Json

@inject BlobServiceClient BlobServiceClient

@* Required *@
<MudThemeProvider />
<MudPopoverProvider />

@* Needed for dialogs *@
<MudDialogProvider />

@* Needed for snackbars *@
<MudSnackbarProvider />

<EditForm FormName="contactForm" Model="@Form" OnValidSubmit="Submit">

    <label for="name">Name:</label>
    <InputText id="name" @bind-Value="Form.Field1" />
    <br />

    <label for="email">Email:</label>
    <InputText id="email" @bind-Value="Form.Field2" />
    <br />

    <label for="phone">Phone:</label>
    <InputText id="phone" @bind-Value="Form.Field3" />
    <br />

    <label for="notes">Notes:</label>
    <InputText id="notes" @bind-Value="Form.Field4" />
    <br />

    <button type="submit">Submit</button>

</EditForm>

@code {
    private FormData Form = new();

    private async Task Submit()
    {
        var container =
            BlobServiceClient.GetBlobContainerClient("submissions");

        await container.CreateIfNotExistsAsync();

        var json = JsonSerializer.Serialize(Form);

        var fileName =
            $"submission-{DateTime.UtcNow:yyyyMMddHHmmss}.json";

        var blob = container.GetBlobClient(fileName);

        using var stream = new MemoryStream(
            System.Text.Encoding.UTF8.GetBytes(json));

        await blob.UploadAsync(stream);

        Console.WriteLine("Upload successful!");
    }

    @* public class FormData
    {
        public string? Field1 { get; set; }
        public string? Field2 { get; set; }
        public string? Field3 { get; set; }
        public string? Field4 { get; set; }
    } *@
}